<aside class="sidebar">
  <div class="sidebar-header">
    <a href="/dashboard" class="brand-logo">
      <div class="brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <span>DocuGovern</span>
      <span class="brand-pill">SaaS</span>
    </a>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section-title">Overview</div>
    <a href="/dashboard" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'dashboard' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="9"></rect>
        <rect x="14" y="3" width="7" height="5"></rect>
        <rect x="14" y="12" width="7" height="9"></rect>
        <rect x="3" y="16" width="7" height="5"></rect>
      </svg>
      <span>Dashboard</span>
    </a>

    <div class="nav-section-title">Document Management</div>
    <a href="/documents" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'documents' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
        <polyline points="13 2 13 9 20 9"></polyline>
      </svg>
      <span>Repository</span>
    </a>

    <a href="/documents/upload" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'upload' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
      <span>Upload Document</span>
    </a>

    <a href="/categories" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'categories' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Categories</span>
    </a>

    <div class="nav-section-title">Workflow & Approval</div>
    <a href="/approvals" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'approvals' ? 'active' : '' %>">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
      <span>Pending Approvals</span>
      <span class="nav-badge">Action</span>
    </a>

    <% if (currentUser && currentUser.role === 'Admin') { %>
      <div class="nav-section-title">Governance Admin</div>
      <a href="/users" class="nav-link <%= typeof activeMenu !== 'undefined' && activeMenu === 'users' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        <span>User Permissions</span>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="user-snippet">
      <div class="user-avatar">
        <%= currentUser && currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div class="user-details">
        <div class="user-name"><%= currentUser ? currentUser.name : 'Corporate User' %></div>
        <span class="user-role-badge"><%= currentUser ? currentUser.role : 'Staff' %></span>
      </div>
      <a href="/logout" title="Sign Out" class="action-icon-btn" style="color: #94a3b8; width: 32px; height: 32px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </a>
    </div>
  </div>
</aside>
