<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>

<div class="main-wrapper">
  <%- include('../partials/topbar') %>

  <main class="dashboard-container">
    <!-- Welcome Header -->
    <div class="dashboard-welcome">
      <div>
        <h1 class="welcome-title">
          <span>Enterprise Governance Hub</span>
          <span style="font-size: 1.1rem; font-weight: 500; color: var(--text-muted);">|</span>
          <span style="font-size: 0.95rem; font-weight: 600; color: var(--primary-600);"><%= currentUser ? currentUser.department : 'Corporate Administration' %></span>
        </h1>
        <p class="welcome-subtitle">
          Real-time visibility into document lifecycles, compliance approvals, and version audit trails.
        </p>
      </div>

      <div class="dashboard-actions">
        <a href="/documents" class="btn btn-secondary btn-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span>View All Docs</span>
        </a>

        <a href="/documents/upload" class="btn btn-primary btn-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Upload Document</span>
        </a>
      </div>
    </div>

    <!-- Stat KPI Cards Grid -->
    <div class="stats-grid">
      <!-- Total Documents -->
      <div class="stat-card primary">
        <div class="stat-card-top">
          <span class="stat-label">Total Documents</span>
          <div class="stat-icon-wrapper primary">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
        </div>
        <div class="stat-value" data-count="<%= stats.totalDocs %>"><%= stats.totalDocs %></div>
        <div class="stat-footer">
          <span class="trend-badge trend-positive">↑ <%= stats.changeThisMonth %></span>
          <span>vs previous quarter</span>
        </div>
      </div>

      <!-- Pending Approvals -->
      <div class="stat-card warning">
        <div class="stat-card-top">
          <span class="stat-label">Pending Reviews</span>
          <div class="stat-icon-wrapper warning">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
        </div>
        <div class="stat-value" data-count="<%= stats.pendingCount %>"><%= stats.pendingCount %></div>
        <div class="stat-footer">
          <span class="trend-badge" style="background: var(--amber-50); color: var(--amber-600);">Requires Action</span>
          <span>Sign-off requested</span>
        </div>
      </div>

      <!-- Approved Documents -->
      <div class="stat-card success">
        <div class="stat-card-top">
          <span class="stat-label">Ratified & Approved</span>
          <div class="stat-icon-wrapper success">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <div class="stat-value" data-count="<%= stats.approvedCount %>"><%= stats.approvedCount %></div>
        <div class="stat-footer">
          <span class="trend-badge trend-positive"><%= stats.approvalRate %>%</span>
          <span>Governance pass rate</span>
        </div>
      </div>

      <!-- Active Categories -->
      <div class="stat-card info">
        <div class="stat-card-top">
          <span class="stat-label">Active Categories</span>
          <div class="stat-icon-wrapper info">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
        </div>
        <div class="stat-value" data-count="<%= categories.length %>"><%= categories.length %></div>
        <div class="stat-footer">
          <span class="trend-badge trend-neutral">Enterprise-wide</span>
          <span>Departmental classifications</span>
        </div>
      </div>

      <!-- Rejected Documents -->
      <div class="stat-card danger">
        <div class="stat-card-top">
          <span class="stat-label">Rejected Documents</span>
          <div class="stat-icon-wrapper danger">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
          </div>
        </div>
        <div class="stat-value" data-count="<%= stats.rejectedCount %>"><%= stats.rejectedCount %></div>
        <div class="stat-footer">
          <span class="trend-badge" style="background: #fff1f2; color: #e11d48;">Requires Revision</span>
          <span>Returned for changes</span>
        </div>
      </div>
    </div>

    <!-- Interactive Charts Section -->
    <div class="charts-grid">
      <!-- Category Distribution -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3 class="card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-600);">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 1 10 10h-10z"></path>
              </svg>
              <span>Document Categories</span>
            </h3>
            <p class="card-subtitle">Distribution across organisational functions</p>
          </div>
        </div>
        <div class="card-body">
          <div class="chart-container" id="categoryDonutChart" data-series='<%- JSON.stringify(categories) %>'></div>
          <div class="chart-legend">
            <% categories.slice(0, 4).forEach(cat => { %>
              <div class="legend-item">
                <div class="legend-left">
                  <span class="legend-color-dot" style="background-color: <%= cat.color || '#4f46e5' %>;"></span>
                  <span><%= cat.name %></span>
                </div>
                <span class="legend-count"><%= cat.count || cat.docCount || 0 %></span>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Monthly Workflow Volume -->
      <div class="card">
        <div class="card-header">
          <div>
            <h3 class="card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--emerald-600);">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              <span>Workflow Approvals Trend</span>
            </h3>
            <p class="card-subtitle">Monthly submissions vs ratified policies (H2 2026)</p>
          </div>
        </div>
        <div class="card-body">
          <div class="chart-container" id="monthlyBarChart"></div>
        </div>
      </div>
    </div>

    <!-- Main Dashboard Split Layout -->
    <div class="dashboard-main-grid">
      <!-- Left Column: Pending Queue & Recent Documents -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        
        <!-- Pending Approvals Action Tray -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--amber-500);">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Awaiting Governance Approval</span>
              </h3>
              <p class="card-subtitle">High priority requests requiring executive review</p>
            </div>
            <a href="/approvals" class="btn btn-secondary btn-sm">View Queue</a>
          </div>

          <div>
            <% if (pendingApprovals && pendingApprovals.length > 0) { %>
              <% pendingApprovals.forEach(approval => { %>
                <div class="pending-approval-item">
                  <div class="approval-item-info">
                    <div class="approval-item-title">
                      <a href="/documents/<%= approval.document ? approval.document._id : '#' %>" style="color: inherit; text-decoration: none;">
                        <%= approval.document ? approval.document.title : 'Governance Document' %>
                      </a>
                    </div>
                    <div class="approval-item-meta">
                      <span class="badge priority-<%= (approval.priority || 'Normal').toLowerCase() %>">
                        <%= approval.priority || 'Normal' %> Priority
                      </span>
                      <span>By <%= approval.submittedBy ? approval.submittedBy.name : 'Author' %> (<%= approval.submittedBy ? approval.submittedBy.department : 'General' %>)</span>
                      <span>• <%= timeAgo(approval.createdAt) %></span>
                    </div>
                  </div>

                  <div class="approval-actions">
                    <button 
                      class="btn btn-secondary btn-sm" 
                      data-id="<%= approval._id %>"
                      data-title="<%= approval.document ? approval.document.title : 'Document' %>"
                      data-submitter="<%= approval.submittedBy ? approval.submittedBy.name : '' %>"
                      onclick="openApprovalModal(this.dataset.id, this.dataset.title, this.dataset.submitter)"
                    >
                      Review
                    </button>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="padding: 2.5rem; text-align: center; color: var(--text-muted);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" style="margin-bottom: 0.5rem;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M8 12l2 2 4-4"></path>
                </svg>
                <div style="font-weight: 600;">All approvals up to date!</div>
                <div style="font-size: 0.8rem; margin-top: 2px;">No documents are currently awaiting your signature.</div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Recent Documents Table -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-600);">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span>Recent Documents & Versions</span>
              </h3>
              <p class="card-subtitle">Active policies, resolutions, and governance assets</p>
            </div>
            <a href="/documents" class="btn btn-secondary btn-sm">Explore Repository</a>
          </div>

          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Document Details</th>
                  <th>Category</th>
                  <th>Version</th>
                  <th>Status</th>
                  <th>Modified</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentDocs && recentDocs.length > 0) { %>
                  <% recentDocs.forEach(doc => { %>
                    <tr>
                      <td>
                        <div class="doc-cell-main">
                          <div class="doc-type-icon">
                            PDF
                          </div>
                          <div>
                            <a href="/documents/<%= doc._id %>" class="doc-name"><%= doc.title %></a>
                            <div class="doc-code"><%= doc.documentNumber %> • By <%= doc.uploadedBy ? doc.uploadedBy.name : 'Author' %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span class="badge" style="background: <%= doc.category && doc.category.color ? doc.category.color + '15' : '#e0e7ff' %>; color: <%= doc.category ? doc.category.color : '#4f46e5' %>; border: 1px solid <%= doc.category ? doc.category.color + '30' : '#c7d2fe' %>;">
                          <%= doc.category ? doc.category.name : 'General' %>
                        </span>
                      </td>
                      <td>
                        <span class="version-pill">v<%= doc.currentVersion %></span>
                      </td>
                      <td>
                        <% if (doc.status === 'Approved') { %>
                          <span class="badge badge-approved"><span class="badge-dot"></span>Approved</span>
                        <% } else if (doc.status === 'Pending_Approval') { %>
                          <span class="badge badge-pending"><span class="badge-dot"></span>Pending</span>
                        <% } else if (doc.status === 'Rejected') { %>
                          <span class="badge badge-rejected"><span class="badge-dot"></span>Rejected</span>
                        <% } else { %>
                          <span class="badge badge-draft"><span class="badge-dot"></span>Draft</span>
                        <% } %>
                      </td>
                      <td style="color: var(--text-muted); font-size: 0.8rem;">
                        <%= timeAgo(doc.updatedAt) %>
                      </td>
                      <td style="text-align: right;">
                        <a href="/documents/<%= doc._id %>" class="btn btn-secondary btn-sm" style="padding: 0.25rem 0.6rem;">
                          Inspect
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                      No documents available in repository yet.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Right Column: Audit Stream & Compliance Cards -->
      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        
        <!-- Activity Stream / Audit Trail -->
        <div class="card">
          <div class="card-header">
            <div>
              <h3 class="card-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-600);">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
                <span>Audit Activity Stream</span>
              </h3>
              <p class="card-subtitle">Real-time immutable audit trail</p>
            </div>
          </div>
          <div class="card-body">
            <div class="activity-stream">
              <% if (recentActivities && recentActivities.length > 0) { %>
                <% recentActivities.forEach(item => { %>
                  <div class="activity-stream-item">
                    <span class="activity-dot"></span>
                    <div class="activity-details">
                      <strong><%= item.user ? item.user.name : 'System' %></strong>
                      <%= item.details %>
                    </div>
                    <div class="activity-meta">
                      <%= timeAgo(item.createdAt) %>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div style="color: var(--text-muted); font-size: 0.85rem;">No recent audit logs available.</div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Quick Governance Checklist / Status Card -->
        <div class="card" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; border: none;">
          <div class="card-body" style="padding: 1.75rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <span class="brand-pill" style="background: rgba(99, 102, 241, 0.3); color: #c7d2fe; border: 1px solid rgba(99, 102, 241, 0.4);">Compliance Status</span>
              <span style="font-size: 0.78rem; color: #94a3b8;">ISO-27001 / SOC-2</span>
            </div>
            <h4 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: #fff;">Organizational Governance</h4>
            <p style="font-size: 0.82rem; color: #cbd5e1; line-height: 1.5; margin-bottom: 1.25rem;">
              All uploaded documents are version-locked and tracked in accordance with enterprise regulatory requirements.
            </p>
            <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.8rem; color: #e2e8f0;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Automated Version Numbering</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Role-Based Segregation of Duties</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Immutable Action Timestamps</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

<!-- Quick Approval Modal Dialog -->
<div class="modal-backdrop" id="quickApprovalModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <h3 class="modal-title">Document Governance Review</h3>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;">Evaluate submitted document for organization ratification.</p>
      </div>
      <button class="modal-close" data-dismiss="modal">&times;</button>
    </div>
    
    <form id="quickApprovalForm" method="POST" action="">
      <div class="modal-body">
        <div style="margin-bottom: 1rem; padding: 1rem; background-color: var(--bg-surface-subtle); border-radius: var(--radius-md);">
          <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 700;">Document Title</div>
          <div id="modalDocTitle" style="font-weight: 600; font-size: 0.95rem; color: var(--text-main); margin-top: 3px;">Document Name</div>
          <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Submitted by <span id="modalSubmitter" style="font-weight: 600;"></span></div>
        </div>

        <div class="form-group">
          <label class="form-label">Reviewer Comments & Compliance Notes</label>
          <textarea 
            name="feedback" 
            class="form-control" 
            placeholder="Add regulatory observations, conditions of approval, or required amendments..."
            rows="3"
          ></textarea>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="submit" name="action" value="reject" class="btn btn-danger btn-sm">Reject / Request Changes</button>
        <button type="submit" name="action" value="approve" class="btn btn-success btn-sm">Sign & Approve</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
