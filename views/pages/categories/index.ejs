<%- include('../../partials/head') %>
<%- include('../../partials/sidebar') %>

<div class="main-wrapper">
  <%- include('../../partials/topbar') %>

  <main class="dashboard-container">
    <div class="dashboard-welcome">
      <div>
        <h1 class="welcome-title">Document Categories</h1>
        <p class="welcome-subtitle">Structure, classify, and partition organisational records and governance assets.</p>
      </div>

      <% if (currentUser && (currentUser.role === 'Admin' || currentUser.role === 'Approver')) { %>
        <div class="dashboard-actions">
          <button class="btn btn-primary btn-sm" onclick="openModal('createCategoryModal')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>New Category</span>
          </button>
        </div>
      <% } %>
    </div>

    <!-- Category Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
      <% if (categories && categories.length > 0) { %>
        <% categories.forEach(cat => { %>
          <div class="card" style="border-top: 4px solid <%= cat.color || '#4f46e5' %>;">
            <div class="card-body" style="padding: 1.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--text-main);"><%= cat.name %></h3>
                <span class="badge" style="background: <%= cat.color || '#4f46e5' %>15; color: <%= cat.color || '#4f46e5' %>; font-weight: 700;">
                  <%= cat.docCount || 0 %> Documents
                </span>
              </div>
              <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; min-height: 40px;">
                <%= cat.description || 'General organisational document repository category.' %>
              </p>
              <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <a href="/documents?category=<%= cat._id %>" class="btn btn-secondary btn-sm" style="font-size: 0.78rem;">
                  Browse Documents
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 3rem;">
          <p style="color: var(--text-muted);">No categories created yet.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal: Create Category -->
<div class="modal-backdrop" id="createCategoryModal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Create Governance Category</h3>
      <button class="modal-close" data-dismiss="modal">&times;</button>
    </div>
    <form action="/categories" method="POST">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Category Name *</label>
          <input type="text" name="name" class="form-control" placeholder="e.g. Board Resolutions & Minutes" required>
        </div>

        <div class="form-group">
          <label class="form-label">Description / Scope</label>
          <textarea name="description" class="form-control" placeholder="What kinds of policies or documents belong in this category?" rows="2"></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Accent Theme Color</label>
          <div style="display: flex; gap: 0.75rem; align-items: center;">
            <input type="color" name="color" value="#4f46e5" style="width: 44px; height: 38px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); cursor: pointer;">
            <span style="font-size: 0.8rem; color: var(--text-muted);">Visual indicator color for badges and chart widgets</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">Create Category</button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
